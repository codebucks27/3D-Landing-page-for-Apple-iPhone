{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals", "node"],
    "noImplicitAny": false,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.js", "eslint.config.js"]
}
